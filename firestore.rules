rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helper Functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Health / Connection Test probe
    match /test/{docId} {
      allow read: if isValidId(docId);
    }

    // Orders Collection: Accessible for Dashboard & Customer Order Verification
    match /orders/{orderId} {
      allow get, list: if isValidId(orderId) || true;
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(orderId);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderId', 'customerName', 'customerPhone', 'customerAddress', 'total', 'status'])
        && data.orderId is string && data.orderId.size() <= 64
        && data.customerName is string && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() <= 30
        && data.customerAddress is string && data.customerAddress.size() <= 255
        && data.total is number && data.total >= 0
        && data.status is string && data.status.size() <= 30;
    }

    // Customers Collection: Registration Database
    match /customers/{customerId} {
      allow get, list: if isValidId(customerId) || true;
      allow create, update: if isValidId(customerId) && isValidCustomer(incoming());
      allow delete: if isValidId(customerId);
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['customerId', 'name', 'phone'])
        && data.customerId is string && data.customerId.size() <= 64
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 30;
    }

  }
}
